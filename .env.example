# Embutida no app em build/dev — o usuário final não configura.
# Em produção preferir Edge Function (GEMINI_API_KEY no Supabase) e deixar vazio.
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase (Fase 2) — Auth, sync e Storage
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Use 0 para forçar IA só no cliente (dev). Padrão: tenta servidor se Supabase estiver configurado.
EXPO_PUBLIC_USE_SERVER_AI=1

# Seed de demonstração no closet (só relevante em builds de produção)
EXPO_PUBLIC_USE_SEED=0
