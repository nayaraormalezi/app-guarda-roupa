{
  "expo": {
    "name": "Personal Stylist",
    "slug": "personal-stylist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalstylist",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nayara.personalstylist",
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a câmera para fotografar peças do seu guarda-roupa.",
        "NSPhotoLibraryUsageDescription": "Usamos a galeria para adicionar fotos das suas peças."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nayara.personalstylist"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para adicionar peças.",
          "cameraPermission": "Permitir acesso à câmera para fotografar peças."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
